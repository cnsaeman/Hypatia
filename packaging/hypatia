#!/bin/sh
# Hypatia launcher. Installed to ~/.local/bin/hypatia by install.sh.
#   hypatia [--line N] [file.tex ...]
# Extra JVM options can be passed in HYPATIA_JAVA_OPTS (e.g. -Dsun.java2d.uiScale=2).
HYPATIA_HOME="${HYPATIA_HOME:-$HOME/.local/share/hypatia}"
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
exec "$JAVA" -Xshare:auto $HYPATIA_JAVA_OPTS -jar "$HYPATIA_HOME/hypatia.jar" "$@"
